# Auth service
AUTH_GRPC_PORT=50051
AUTH_HTTP_PORT=8080

# PostgreSQL — задайте пароль и DSN сами; для docker compose см. POSTGRES_PASSWORD ниже.
# Локально с compose (Postgres наружу на 5433): скопируйте в .env и выровняйте пароль с POSTGRES_PASSWORD.
POSTGRES_PASSWORD=
POSTGRES_DSN=postgres://dealer:<set-password>@127.0.0.1:5433/dealer?sslmode=disable

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_AUTH_EVENTS=auth.events
KAFKA_TOPIC_ERRORS=platform.errors.v1
KAFKA_TOPIC_CLIENT_REGISTRATION=client.registration.v1
KAFKA_TOPIC_DEAL_COMPLETED=deal.completed.v1
KAFKA_TOPIC_REVIEW_PUBLISHED=review.published.v1

# ClickHouse (errors-ingest-service). Должен совпадать с паролем сервиса clickhouse в compose.
CLICKHOUSE_ADDR=127.0.0.1:9000
CLICKHOUSE_DATABASE=analytics
CLICKHOUSE_PASSWORD=changeme

# JWT
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
