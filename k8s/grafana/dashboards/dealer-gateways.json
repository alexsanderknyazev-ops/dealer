{
  "title": "Dealer / Gateways",
  "uid": "dealer-gateways",
  "tags": ["dealer", "gateways"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "type": "timeseries",
      "title": "Employee gateway — HTTP RPS",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "sum(rate(http_requests_total{service=\"gateway-service\"}[5m]))", "legendFormat": "RPS", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Client public gateway — HTTP RPS",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "sum(rate(http_requests_total{service=\"client-public-gateway-service\"}[5m]))", "legendFormat": "RPS", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Client protected gateway — HTTP RPS",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "sum(rate(http_requests_total{service=\"client-protected-gateway-service\"}[5m]))", "legendFormat": "RPS", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Employee gateway — p95 latency",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "datasource": "Prometheus",
      "targets": [{
        "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{service=\"gateway-service\"}[5m])))",
        "legendFormat": "p95",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Employee gateway — top API paths",
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 8 },
      "datasource": "Prometheus",
      "targets": [{
        "expr": "topk(15, sum by (path) (rate(http_requests_total{service=\"gateway-service\",path=~\"/api/.*\"}[5m])))",
        "legendFormat": "{{path}}",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "5xx rate — all gateways",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "datasource": "Prometheus",
      "targets": [{
        "expr": "sum by (service) (rate(http_requests_total{service=~\".*gateway.*\",status=~\"5..\"}[5m]))",
        "legendFormat": "{{service}}",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    }
  ]
}
